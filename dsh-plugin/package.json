{
  "name": "@wave-insight/dsh-plugin",
  "version": "0.2.1",
  "type": "module",
  "description": "Wave Insight waveform tools and a live side panel for DeepSeek Harness",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wave-Insight/wave-insight.git",
    "directory": "dsh-plugin"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "host/**/*",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "icon.svg",
    "bin/dsh-bridge-windows-x64.exe",
    "bin/dsh-bridge-linux-x64",
    "bin/dsh-bridge-macos-arm64",
    "bin/wave-insight-web-backend-windows-x64.exe",
    "ui/**/*"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
