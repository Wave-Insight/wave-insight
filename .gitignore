#cargo/trunk output
/target
/front-end/dist
/front-end/dist-web

#testbench dumps dropped in the repository root (readme: "drop one there first").
#scoped to the root on purpose: fixtures under tests/data/ stay committable,
#e.g. wave-insight-lib/tests/data/*.vcd
/test*.vcd
*.fst
*.ghw
!/wave-insight-lib/tests/data/*.fst
!/wave-insight-lib/tests/data/*.ghw
!/qa/fixtures/*.fst
!/qa/fixtures/*.ghw

#editor / OS noise
.DS_Store
node_modules/

#agent tooling session state (never part of the app)
/.commandcode/

#DSH plugin native binaries: built per platform by
#.github/workflows/dsh-plugin-binaries.yml and unpacked into the release
#tarball, or staged locally with `node dsh-plugin/scripts/binaries.mjs stage`.
#A checkout has none of them, and none of them may be committed again.
/dsh-plugin/bin/

#browser QA artifacts: the staged build, the chrome profile and the screenshots
/qa/.stage/
/qa/artifacts/
